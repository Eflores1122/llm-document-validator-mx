# Optional vendor credentials. Leave them blank to use the free local path:
# pdfplumber/pypdf for parsing and the deterministic extractor for fields.
# Never commit a real .env file.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=fast
LLAMA_PARSE_TIMEOUT_S=120

# Cross-document rule thresholds.
DOCVAL_CONTRACT_MAX_GAP_DAYS=7
DOCVAL_ADDRESS_MAX_AGE_DAYS=90

# Used by the optional API when validating a dataset case by id.
DOCVAL_GOLDEN_ROOT=data/golden
